<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rexify Automation Control</title>
  <style>
    body { background: #0f1117; color: #fff; font-family: monospace; padding: 20px; }
    .container { max-width: 800px; margin: auto; }
    button { padding: 10px 20px; font-weight: bold; cursor: pointer; border: none; border-radius: 5px; }
    #startBtn { background: #10b981; color: white; }
    #stopBtn { background: #ef4444; color: white; margin-left: 10px; }
    #logBox { background: #1f2937; padding: 15px; height: 400px; overflow-y: auto; border-radius: 5px; margin-top: 20px; font-size: 13px; }
    .info { color: #38bdf8; }
    .error { color: #f87171; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Automation Control</h2>
    <p>Multi-tier referral network loop active.</p>
    <div>
      <button id="startBtn" onclick="startBot()">Start automation</button>
      <button id="stopBtn" onclick="stopBot()">Stop</button>
    </div>
    <div id="logBox"></div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const logBox = document.getElementById('logBox');

    socket.on('log', (data) => {
      const div = document.createElement('div');
      div.className = data.type;
      div.textContent = `[${data.timestamp}] ${data.message}`;
      logBox.appendChild(div);
      logBox.scrollTop = logBox.scrollHeight;
    });

    function startBot() {
      socket.emit('start');
    }

    function stopBot() {
      socket.emit('stop');
    }
  </script>
</body>
</html>
